   "issues": [
    {
     "t": "Ringland and piston failure",
     "kind": "Parts seller / enthusiast outlet",
     "rx": "ring ?lands?|cracked piston|piston (failure|crack)|low compression",
     "x": "Detonation can crack a piston ring land, causing low compression, blow-by and oil burning. Parts sellers say it happens on stock cars too, more often with bad tunes, low octane or full throttle at low rpm.",
     "fix": "Rebuild with new pistons; Subaru switched to stronger pistons for 2019.",
     "src": [
      "maperf",
      "cadi",
      "sgw",
      "s19p"
     ]
    },
    {
     "t": "Bearing failure from oil starvation",
     "kind": "Owner-reported",
     "rx": "spun (a )?(rod )?bearing|rod bearings?|rod knock|bearing failure",
     "x": "SlashGear, citing a YouTube mechanic, names oil starvation of the second and third bearings as the main EJ257 problem, which can end in bearing failure.",
     "fix": "",
     "src": [
      "sgw"
     ]
    },
    {
     "t": "Head gasket leaks",
     "kind": "Outlet",
     "rx": "head gaskets?",
     "x": "Head gasket failures happen on the EJ257 but less often than on other EJ engines, and are more likely with a higher-boost tune, per SlashGear.",
     "fix": "",
     "src": [
      "sgw"
     ]
    },
    {
     "t": "Oil consumption",
     "kind": "Enthusiast outlet",
     "rx": "oil consumption|burning oil|using oil",
     "x": "A cracked ring land lets combustion gas pressurize the crankcase, which burns oil. Rising oil use can be an early warning, so check the level often.",
     "fix": "",
