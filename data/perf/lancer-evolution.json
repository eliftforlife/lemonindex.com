     ]
    },
    {
     "t": "Timing belt area noise (2006)",
     "kind": "Owner-reported (NHTSA)",
     "rx": "timing belt|idler pulley|tensioner",
     "x": "Thirteen 2006 Evo IX complaints describe a grinding or scraping noise from the timing belt area, mostly on cold starts. Owners blame the idler pulley or tensioner bracket, and some say a dealer pulley swap did not stop it.",
     "fix": "",
     "src": [
      "nc06"
     ]
    },
    {
     "t": "Turbo coolant hose recall",
     "kind": "Recall",
     "rx": "coolant (hose|leak)|turbo.{0,20}coolant",
     "x": "On some 2005 cars the turbocharger coolant hose was made wrong and can leak. Coolant on the hot manifold can catch fire.",
