   "issues": [
    {
     "t": "Supercharger rattle at idle",
     "kind": "Maker bulletin",
     "rx": "supercharger (rattle|rattling|noise|bearing)|isolator|coupler",
     "x": "GM found the supercharger on 2012–2013 ZL1s (and 2009–2013 CTS-Vs) can rattle at idle. Left alone, it can ruin the bearing grease and, in the worst case, stop the engine.",
     "fix": "Dealers replace the supercharger free under a special coverage of 10 years or 120,000 miles.",
     "src": [
      "ma14"
     ]
    },
    {
     "t": "Low-rpm buzz on replacement superchargers",
     "kind": "Maker bulletin",
     "rx": "buzz|flutter",
     "x": "On cars with a replacement supercharger (solid coupling), a buzz at 800–900 rpm in second or third gear under load is normal, GM told dealers.",
     "fix": "No repair; GM said not to replace parts for this noise.",
     "src": [
      "pip5192"
     ]
    }
   ]
  },
